<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To say "you are on mobile data" before the speech model is downloaded -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- So that listening to a mentor meeting can carry on with the phone locked, under its own notice -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Only asked for when you tap the microphone: Speak (speech to text) or the Chat tab -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Lets the app find the phone's voice for Listen and its speech recogniser for Speak (Android 11 and later),
         and see whether the PebblePad app (PebblePocket) is installed, so that it can open it -->
    <queries>
        <package android:name="pebblepad.PebblePocket.android" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share" a web page or some words from another app, and Cap and Gown reads it aloud -->
            <intent-filter android:label="Listen in Cap and Gown">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The online library and recommended readings, videos and podcasts open here, inside the app -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:hardwareAccelerated="true" />

        <!-- A lesson video plays here, inside the app, in YouTube's own embedded player -->
        <activity
            android:name=".VideoActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:hardwareAccelerated="true" />

        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/AlarmTheme" />

        <service
            android:name=".AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Keeps Listen reading with the screen off, with Pause and Stop on its notification -->
        <service
            android:name=".ReadAloudService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Keeps a podcast playing with the screen off, with its controls on the notification and lock screen -->
        <service
            android:name=".PodcastService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Keeps the mentor meeting listener going with the phone locked or another app open. It shows a notice
             with Pause for as long as it listens. Only words are kept: no sound is saved. The app's own
             listening (OwnSpeech) relies on it: the phone's speech service may still stop when the screen goes off. -->
        <service
            android:name=".MeetingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The speech engine's own screen for asking for the microphone is not used: the app asks itself -->
        <activity
            android:name="ai.moonshine.voice.MicrophonePermissionActivity"
            tools:node="remove" />

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
